<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Deliberately reference the checked-out CUE4Parse source instead of the
      NuGet package. The August 2026 NuGet package does not expose the same
      conversion API as current source (Options/ExportSession), which caused
      the CS0234 build failure on GitHub Actions.
    -->
    <ProjectReference Include="../../vendor/CUE4Parse/CUE4Parse/CUE4Parse.csproj" />
    <ProjectReference Include="../../vendor/CUE4Parse/CUE4Parse-Conversion/CUE4Parse-Conversion.csproj" />
  </ItemGroup>
</Project>
